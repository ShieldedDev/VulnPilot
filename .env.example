# VulnPilot local environment configuration
# Copy this file to .env and customize as needed.

VULNPILOT_ADMIN_USER=admin
VULNPILOT_ADMIN_EMAIL=admin@vapt.local
VULNPILOT_ADMIN_PASSWORD=ChangeMeStrongly!

# Optional scanner overrides
VULNPILOT_TIMEOUT=10
VULNPILOT_RETRIES=2
VULNPILOT_CONCURRENCY=5
VULNPILOT_RATE_LIMIT=1.0
VULNPILOT_USER_AGENT=VulnPilot/1.1 (authorized security testing only)
